    "    if img is not None:\n",
    "        height, width = img.size\n",
    "        aspect_ratio = width / height\n",
    "        \n",
    "        train_images.append({\n",
    "            \"path\": img_path,\n",
    "            \"height\": height,\n",
    "            \"width\": width,\n",
    "            \"aspect_ratio\": aspect_ratio\n",
    "        })\n",
    "    else:\n",
    "        print(\"Image not found or failed to load.\")\n"
